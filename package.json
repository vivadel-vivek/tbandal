{
  "name": "two-buds-and-a-leaf",
  "version": "0.2.0",
  "private": true,
  "description": "Two Buds and a Leaf — editorial tea library, journal, and recommendation engine.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prototype": "cd prototype && npx --yes serve . -l 3001",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:diff": "supabase db diff -f new_migration",
    "supabase:push": "supabase db push",
    "supabase:gen-types": "supabase gen types typescript --local > lib/supabase/types.ts",
    "test:seed": "node scripts/seed-test-users.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "ws": "^8.20.0"
  }
}
