# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.production
.env.development

# vercel
.vercel

# supabase — local stack debris (config.toml IS committed; runtime
# state and the linked-project marker are not)
/supabase/.branches
/supabase/.temp
/supabase/.env
/.supabase/

# Playwright test scaffolding — seeded credentials are ephemeral
# (regen on every `npm run test:seed`); HTML reports are large.
/tests/.test-users.json
/test-results/
/playwright-report/

# typescript
*.tsbuildinfo
next-env.d.ts

# audit reports (Lighthouse output + Playwright capture artifacts)
/.audit
/audit-artifacts/

# locally-running scheduled-task bookkeeping
/.claude/scheduled_tasks.lock

# persona-agent curl debris (created when sub-agents fetch pages with
# `curl -o` and accidentally use a Windows-style path as the filename,
# or write tmp files at the project root).
Usersvshim*.html
/strip.py
/_t_*.txt
/_t_*.html
/audit_*.html
/audit_*.txt

.vercel
