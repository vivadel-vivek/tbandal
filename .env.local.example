# Two Buds and a Leaf — local environment.
#
# Copy this file to `.env.local` and fill in real values. .env.local is
# git-ignored; never commit secrets. For Vercel deployments, set the
# same names + values in Project Settings → Environment Variables.
#
# Two ways to source the Supabase values:
#
#  A) Local Supabase stack (recommended for dev):
#     1. Install the CLI:        npm i -g supabase   (or brew install supabase/tap/supabase)
#     2. Start the local stack:  supabase start      (runs Postgres + Auth in Docker)
#     3. Read the printed URL/keys; the local anon key is published in
#        the CLI output and is fine to commit if needed (it's local-only).
#
#  B) Hosted project (for staging / production):
#     1. https://supabase.com → your project → Settings → API
#     2. Copy the project URL and the anon (publishable) + service_role keys.
#
# The service-role key is server-only and bypasses Row-Level Security —
# never expose it to the client bundle (no NEXT_PUBLIC_ prefix).

# Required — public, sent to the client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Required — server-side only (RLS bypass for admin/webhook paths)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional — pin the canonical site URL so sitemap / og:image / canonical
# tags don't fall back to the deployment-hash URL.
NEXT_PUBLIC_SITE_URL=https://two-buds-and-a-leaf.vercel.app
