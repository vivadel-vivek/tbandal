# Two Buds and a Leaf — environment variables
# Copy to .env.local for development. Vercel project env vars override
# at build/runtime in production.

# ---- Site identity ---------------------------------------------------
# Public canonical URL. Used by metadataBase, sitemap.ts, robots.ts,
# /go/[vendor] redirects, and the SEO meta layer. On Vercel the project
# usually sets this to https://twobudsandaleaf.com (production) and
# uses VERCEL_URL fallback for preview deploys automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Phase 6b — Airtable (editorial content) -------------------------
# Set once Airtable goes live. Leave blank locally and the lib/data.ts
# mock arrays serve as the data source.
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_REVALIDATE_SECRET=  # POST'd by Airtable webhook to /api/revalidate

# ---- Phase 6c — Auth + DB --------------------------------------------
# NextAuth (Google OAuth)
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Postgres (Supabase or Vercel Postgres) — user data: ratings, blind
# list, settings, review requests.
# DATABASE_URL=
